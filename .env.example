# App
NEXT_PUBLIC_SITE_URL=https://mash.catplay.org
NEXT_PUBLIC_API_URL=https://mash.catplay.org
# Browser connects here (tunnel routes ws.mash.catplay.org -> localhost:8084). For local dev without tunnel: ws://localhost:8080
NEXT_PUBLIC_WS_URL=wss://ws.mash.catplay.org/ws

NEXT_PUBLIC_CLOSE_SITE=false

# WebSocket Server (internal server-to-server calls, stays local)
WS_SERVER_URL=http://localhost:8080
WS_API_KEY=development_api_key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/catmash

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Better Auth)
# Generate a secure secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your_super_secret_random_string
BETTER_AUTH_URL=https://mash.catplay.org
BETTER_AUTH_TRUSTED_ORIGINS=https://mash.catplay.org

# Google Auth
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Add redirect URI: https://mash.catplay.org/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Local file storage (replaces Backblaze B2)
# Path is resolved from the server working dir (use an absolute path in Docker).
MEDIA_STORAGE_PATH=./data